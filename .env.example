# LiveRecall environment configuration
# Copy to .env and fill in. Never commit .env.

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- MongoDB Atlas (Sandbox) ---
# Use the Sandbox cluster from the hackathon link, NOT a personal Atlas.
MONGODB_URI=mongodb+srv://<user>:<pass>@<sandbox>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=liverecall

# --- OpenAI (Vision GPT-4o, Router/Reranker/Answerer GPT-4o-mini, embeddings) ---
OPENAI_API_KEY=

# --- Deepgram (streaming STT, Nova-2) ---
DEEPGRAM_API_KEY=

# --- ElevenLabs (streaming TTS, Flash v2.5 for live, Multilingual v2 for video voiceover) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_BACKEND_URL=http://localhost:8000

# --- Dashboard ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/stream
