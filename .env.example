# LiveRecall environment configuration
# Copy to .env and fill in. Never commit .env.

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- MongoDB Atlas (Sandbox) ---
# Use the Sandbox cluster from the hackathon link, NOT a personal Atlas.
MONGODB_URI=mongodb+srv://<user>:<pass>@<sandbox>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=liverecall

# --- OpenAI (Vision GPT-4o, Router/Reranker/Answerer GPT-4o-mini, embeddings) ---
OPENAI_API_KEY=

# --- ElevenLabs (streaming STT Scribe v2 Realtime + streaming TTS Flash v2.5) ---
# One key, two services. See DECISIONS.md for why we dropped Deepgram.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PUBLIC_BACKEND_URL=http://localhost:8000

# --- Phone demo tunnels (optional; `make phone-demo`) ---
# Prefer ngrok over flaky Cloudflare Quick Tunnel (429). Token:
# https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

# --- Dashboard ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS=ws://localhost:8000/stream
